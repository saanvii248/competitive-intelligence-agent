# ==================================================
# Competitive Intelligence Agent - Configuration
# ==================================================

# Application Identity
APP_NAME="Competitive Intelligence Agent"
APP_SUBTITLE="An AI agent that remembers competitor moves and uncovers strategic patterns."

# Server Configuration
HOST=0.0.0.0
PORT=8000

# --------------------------------------------------
# Hindsight by Vectorize (Persistent Memory Layer)
# --------------------------------------------------
# Set your Hindsight credentials below when available.
# Hindsight Cloud: https://api.hindsight.vectorize.io
# Self-Hosted Docker: http://localhost:8888
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=competitive-intelligence-bank

# Force local persistent fallback even if Hindsight is configured (true/false)
FORCE_LOCAL_MEMORY=false

# --------------------------------------------------
# LLM Provider Configuration
# --------------------------------------------------
# Provider options: auto, groq, openai, local
LLM_PROVIDER=auto

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
